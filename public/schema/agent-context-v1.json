{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevBugTrackerAgentContext",
  "description": "Schema definition for AI coding agent context generated by DevBug Tracker.",
  "type": "object",
  "required": ["app", "generated_at", "project", "metrics", "active_issues", "agent_instructions"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "app": {
      "type": "string",
      "const": "DevBug Tracker"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "repository_url": { "type": ["string", "null"] },
        "tech_stack": {
          "type": "array",
          "items": { "type": "string" }
        },
        "test_command": { "type": ["string", "null"] }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["total_active_issues", "critical_count", "resolved_count"],
      "properties": {
        "total_active_issues": { "type": "integer", "minimum": 0 },
        "critical_count": { "type": "integer", "minimum": 0 },
        "resolved_count": { "type": "integer", "minimum": 0 }
      }
    },
    "active_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "status": {
            "type": "string",
            "enum": ["open", "in_progress", "resolved", "closed"]
          },
          "fix_hint": { "type": ["string", "null"] },
          "suspected_files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": { "type": ["string", "null"] },
          "steps_to_reproduce": { "type": ["string", "null"] },
          "expected_result": { "type": ["string", "null"] },
          "actual_result": { "type": ["string", "null"] },
          "stack_trace": { "type": ["string", "null"] },
          "environment": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "resolved_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "resolved_at": { "type": ["string", "null"] },
          "resolved_commit": { "type": ["string", "null"] }
        }
      }
    },
    "agent_instructions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
