# ==============================================================================
# DEVBUG TRACKER CONFIGURATION
# For full database selection and setup guide, see: skills/database-setup/SKILL.md
# ==============================================================================

# Supabase / PostgreSQL Configuration (Cloud or Local Docker)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP Configuration (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="DevBug Tracker <your-email@gmail.com>"
